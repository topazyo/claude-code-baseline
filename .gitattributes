# The LAST matching line wins in gitattributes, so the catch-all must come FIRST.
# With it last, `* text=auto` overrode the specific `*.sh text eol=lf` below and
# CRLF written by a Windows editor was committed verbatim — which ships shell
# scripts that die on Linux with "bad interpreter: no such file or directory".
* text=auto eol=lf

# Explicit, for the files where a stray CR is fatal rather than cosmetic.
*.sh        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
VERSION     text eol=lf
CODEOWNERS  text eol=lf
